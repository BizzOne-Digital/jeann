# Finekarts Incorporated — environment placeholders
# Copy to .env.local and fill values. Never commit real secrets.

NODE_ENV=development
APP_URL=http://localhost:3000

# MongoDB (required for full platform persistence)
MONGODB_URI=mongodb://127.0.0.1:27017/finekarts
MONGODB_DB_NAME=finekarts

# Auth / sessions (min 32 characters in production)
SESSION_SECRET=replace-with-a-long-random-session-secret
AUTH_SECRET=replace-with-a-long-random-auth-secret

# Initial administrator (used only by seed/CLI — not exposed to clients)
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace-with-strong-password
INITIAL_ADMIN_NAME=Platform Administrator

# Email provider: none | console | resend | smtp
EMAIL_PROVIDER=console
EMAIL_FROM=Info@finekarts.com
EMAIL_API_KEY=

# SMS / OTP: none | console | twilio
SMS_PROVIDER=none
SMS_API_KEY=
REQUIRE_PHONE_OTP=false

# Private object storage: local | s3
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Malware scanning adapter: none | console
MALWARE_SCAN_PROVIDER=none

# Groq (preferred for public chatbot — server-side only)
GROQ_ENABLED=false
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini (optional fallback — server-side only)
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional integrations
CRM_PROVIDER=internal
NEWSLETTER_PROVIDER=internal
SHIPMENT_TRACKING_PROVIDER=manual
SHIPMENT_WEBHOOK_SECRET=

# Feature flags
FEATURE_SUPPLIER_PORTAL=true
FEATURE_BANKING_PORTAL=true
FEATURE_AI_ASSISTANT=true
FEATURE_FINANCE_MODULE=true
FEATURE_DEMO_DATA=true
